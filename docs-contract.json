{
  "compatibility": {
    "matrix": [
      {
        "boundary": "`engines.node >= 22.12`. ESM build only; CommonJS applications load it through Node's `require(esm)`. Resource-bound checks (heap flags, worker memory limits, export-deadline socket close) are verified on Node; Bun does not enforce worker `resourceLimits`.",
        "path": "TypeScript core and evaluations",
        "verifiedSupport": "Node.js 22 and 24 (CI also runs 26); Bun 1.4.2 runs the installed-package suite and the reference chatbot; compiled ESM and type declarations"
      },
      {
        "boundary": "Install both adapter peers; preserve an existing global integration.",
        "path": "Vercel AI SDK adapter",
        "verifiedSupport": "AI SDK / OTel pairs `7.0.99 / 1.0.99` and `7.0.100 / 1.0.100`"
      },
      {
        "boundary": "Core-only installation supports AI SDK 6; the Hue AI SDK adapter requires version 7.",
        "path": "Existing JavaScript OTel provider",
        "verifiedSupport": "Hue transport attached to an application's provider; other exporters remain usable"
      },
      {
        "boundary": "`opentelemetry-api`, `opentelemetry-sdk` and `opentelemetry-exporter-otlp-proto-http` are accepted as `>=1.40,<2`; other releases inside the range are accepted by the resolver but not individually certified; new 1.x releases are adopted through a `uv.lock` bump once the frozen CI jobs pass. Local evaluation checkpoints require POSIX filesystem behavior.",
        "path": "Python tracing and evaluations",
        "verifiedSupport": "Python 3.10 and 3.14 with OpenTelemetry 1.44.0, the certified combination recorded in `uv.lock`; Python 3.10 and 3.12 with OpenTelemetry 1.40.0, the declared floor"
      },
      {
        "boundary": "Configure the instrumentor's own content controls. This does not certify every provider API.",
        "path": "Python OpenAI instrumentation",
        "verifiedSupport": "OpenAI 3.14.0 and OpenInference OpenAI 0.1.60, using a synthetic HTTP streaming provider"
      },
      {
        "boundary": "No Hue package or model wrapper required; metrics and OTLP gRPC ingestion are not supported.",
        "path": "Direct OpenTelemetry export",
        "verifiedSupport": "OTLP HTTP protobuf/JSON traces and correlated logs, including gzip"
      }
    ],
    "sections": [
      "Existing dependencies",
      "Content and delivery",
      "Evaluation coverage",
      "Hue-managed runs",
      "Failure isolation",
      "App-launched local agents",
      "Scorer forward compatibility"
    ],
    "sha256": "sha256:8401f47ec6fe7ecdd8a8acc178ee29b3aa81cc6363c9d8abb8fc642dbfe31c2d",
    "source": "COMPATIBILITY.md"
  },

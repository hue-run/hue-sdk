{
  "name": "hue-run",
  "version": "0.5.1",
  "description": "Alias of @hue-run/sdk. Install @hue-run/sdk directly; this package only re-exports it.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.hue.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hue-run/hue-sdk.git",
    "directory": "packages/aliases/npm-hue-run"
  },
  "bugs": {
    "url": "https://github.com/hue-run/hue-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "index.js",
    "ai-sdk.js",
    "evals.js",
    "managed.js",
    "environment.js",
    "setup.js",
    "setup-events.schema.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hue": "./bin/hue.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./ai-sdk": "./ai-sdk.js",
    "./evals": "./evals.js",
    "./managed": "./managed.js",
    "./environment": "./environment.js",
    "./setup": "./setup.js",
    "./setup-events.schema.json": "./setup-events.schema.json"
  },
  "dependencies": {
    "@hue-run/sdk": "0.5.1"
  }
}

{
  "name": "@hue-run/sdk",
  "version": "0.3.2",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://docs.hue.run",
  "bugs": {
    "url": "https://github.com/hue-run/hue-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hue-run/hue-sdk.git",
    "directory": "packages/sdk-typescript"
  },
  "description": "Hue OpenTelemetry helpers for Node.js agent applications",
  "keywords": [
    "opentelemetry",
    "otlp",
    "tracing",
    "observability",
    "llm",
    "ai-agents",
    "evaluation",
    "vercel-ai-sdk"
  ],
  "files": [
    "dist",
    "CLI.md",
    "setup-events.schema.json",
    "README.md",
    "EVALUATIONS.md",
    "ENVIRONMENTS.md",
    "MANAGED_TARGETS.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "hue": "./dist/setup/cli.js"
  },
  "sideEffects": [
    "./dist/evals/schema-worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./evals": {
      "types": "./dist/evals.d.ts",
      "import": "./dist/evals.js",
      "default": "./dist/evals.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./managed": {
      "types": "./dist/managed.d.ts",
      "import": "./dist/managed.js",
      "default": "./dist/managed.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "default": "./dist/setup.js"
    },
    "./setup-events.schema.json": "./setup-events.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-trace": "2.11.0"
  },
  "devDependencies": {
    "@ai-sdk/otel": "1.0.99",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "ai": "7.0.99",
    "ajv": "8.20.0",
    "protobufjs": "8.8.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/otel": "^1.0.99",
    "@opentelemetry/api": "^1.9.1",
    "ai": "^6.0.0 || ^7.0.99",
    "ajv": "^8.17.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/otel": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}

{
  "encode": [
    {
      "name": "all three identifiers into an empty carrier",
      "identity": {
        "sessionId": "slack:T1:C1:1712.5",
        "userId": "org_1:U9",
        "workspaceId": "T1"
      },
      "existing": null,
      "expected": "hue.session.id=slack%3AT1%3AC1%3A1712.5,hue.user.id=org_1%3AU9,hue.workspace.id=T1",
      "omittedTooLong": 0
    },
    {
      "name": "reserved characters are percent-encoded with uppercase hex",
      "identity": {
        "sessionId": "a b+c,d;e=f%g\"h\\i",
        "userId": "é中文😀",
        "workspaceId": "~-._!'()*"
      },
      "existing": null,
      "expected": "hue.session.id=a%20b%2Bc%2Cd%3Be%3Df%25g%22h%5Ci,hue.user.id=%C3%A9%E4%B8%AD%E6%96%87%F0%9F%98%80,hue.workspace.id=~-._%21%27%28%29%2A",
      "omittedTooLong": 0
    },
    {
      "name": "an existing header is a prefix when nothing is stripped",
      "identity": {
        "sessionId": "s"
      },
      "existing": "hue-world=0b7c2d4e-1f3a-4b5c-8d9e-0a1b2c3d4e5f, app=a%2Cb;p=1",
      "expected": "hue-world=0b7c2d4e-1f3a-4b5c-8d9e-0a1b2c3d4e5f, app=a%2Cb;p=1,hue.session.id=s",
      "omittedTooLong": 0
    },
    {
      "name": "a stale Hue member is replaced",
      "identity": {
        "userId": "new"
      },
      "existing": "hue.user.id=old,app=1",
      "expected": "app=1,hue.user.id=new",
      "omittedTooLong": 0
    },
    {
      "name": "an empty identity still strips forged Hue members",
      "identity": {},
      "existing": "hue-world=w,hue.user.id=forged,hue.workspace.id=evil",
      "expected": "hue-world=w",
      "omittedTooLong": 0
    },
    {
      "name": "a header holding only a forged Hue member is removed",
      "identity": {},
      "existing": "hue.session.id=forged",
      "expected": null,
      "omittedTooLong": 0
    },
    {
      "name": "a whitespace header is replaced",
      "identity": {
        "sessionId": "s"
      },
      "existing": "  ",
      "expected": "hue.session.id=s",
      "omittedTooLong": 0
    },
    {
      "name": "Hue members with whitespace and properties are stripped",
      "identity": {},
      "existing": "app=1, hue.session.id = x ;p=1 ,other=2",
      "expected": "app=1,other=2",
      "omittedTooLong": 0
    },
    {
      "name": "names compare case-sensitively",
      "identity": {
        "userId": "u"
      },
      "existing": "HUE.USER.ID=x",
      "expected": "HUE.USER.ID=x,hue.user.id=u",
      "omittedTooLong": 0
    },
    {
      "name": "only the identifiers that are set are written",
      "identity": {
        "userId": "u-only"
      },
      "existing": null,
      "expected": "hue.user.id=u-only",
      "omittedTooLong": 0
    },
    {
      "name": "nothing to write and nothing to strip leaves no header",
      "identity": {},
      "existing": null,
      "expected": null,
      "omittedTooLong": 0
    },
    {
      "name": "nothing to write and nothing to strip keeps the header",
      "identity": {},
      "existing": "app=1",
      "expected": "app=1",
      "omittedTooLong": 0
    },
    {
      "name": "invalid identifiers are skipped",
      "identity": {
        "sessionId": "",
        "userId": "x\u0000y",
        "workspaceId": "w"
      },
      "existing": null,
      "expected": "hue.workspace.id=w",
      "omittedTooLong": 0
    },
    {
      "name": "a 4,079-byte workspace identifier fills a 4,096-byte member",
      "identity": {
        "workspaceId": ""
      },
      "existing": null,
      "expected": "hue.workspace.",
      "omittedTooLong": 0
    },
    {
      "name": "a 4,080-byte workspace identifier is omitted",
      "identity": {
        "sessionId": "s",
        "workspaceId": ""
      },
      "existing": null,
      "expected": "hue.session.id=s",
      "omittedTooLong": 1
    }
  ],
  "decode": [
    {
      "name": "all three identifiers",
      "header": "hue.session.id=slack%3AT1%3AC1%3A1712.5,hue.user.id=org_1%3AU9,hue.workspace.id=T1",
      "identity": {
        "sessionId": "slack:T1:C1:1712.5",
        "userId": "org_1:U9",
        "workspaceId": "T1"
      }
    },
    {
      "name": "optional whitespace and properties",
      "header": " hue.session.id = s1 ;p=1 , hue.user.id=u1",
      "identity": {
        "sessionId": "s1",
        "userId": "u1"
      }
    },
    {
      "name": "other members, hue-world included, are ignored",
      "header": "hue-world=0b7c2d4e-1f3a-4b5c-8d9e-0a1b2c3d4e5f,app=1,hue.workspace.id=T1",
      "identity": {
        "workspaceId": "T1"
      }
    },
    {
      "name": "plus is a literal plus",
      "header": "hue.user.id=a+b",
      "identity": {
        "userId": "a+b"
      }
    },
    {
      "name": "lowercase hex escapes decode",
      "header": "hue.session.id=%c3%a9",
      "identity": {
        "sessionId": "é"
      }
    },
    {
      "name": "identical duplicates are accepted",
      "header": "hue.user.id=a,hue.user.id=a",
      "identity": {
        "userId": "a"
      }
    },
    {
      "name": "a conflicting duplicate drops that field",
      "header": "hue.user.id=a,hue.user.id=b,hue.session.id=s",
      "identity": {
        "sessionId": "s"
      }
    },
    {
      "name": "an invalid duplicate drops that field",
      "header": "hue.user.id=%zz,hue.user.id=a",
      "identity": null
    },
    {
      "name": "a malformed escape",
      "header": "hue.session.id=%zz",
      "identity": null
    },
    {
      "name": "an escape that is not UTF-8",
      "header": "hue.session.id=%C3%28",
      "identity": null
    },
    {
      "name": "an encoded surrogate",
      "header": "hue.session.id=%ED%A0%80",
      "identity": null
    },
    {
      "name": "an encoded NUL",
      "header": "hue.session.id=%00",
      "identity": null
    },
    {
      "name": "a raw non-ASCII character",
      "header": "hue.user.id=é",
      "identity": null
    },
    {
      "name": "a raw double quote",
      "header": "hue.user.id=a\"b",
      "identity": null
    },
    {
      "name": "a raw backslash",
      "header": "hue.user.id=a\\b",
      "identity": null
    },
    {
      "name": "4,097 UTF-16 code units",
      "header": "hue.session.",
      "identity": null
    },
    {
      "name": "4,096 UTF-16 code units",
      "header": "hue.session.",
      "identity": {
        "sessionId": ""
      }
    },
    {
      "name": "a name in another case",
      "header": "HUE.SESSION.ID=x",
      "identity": null
    },
    {
      "name": "an empty value",
      "header": "hue.session.id=",
      "identity": null
    },
    {
      "name": "a member without a value",
      "header": "hue.user.id",
      "identity": null
    },
    {
      "name": "a property before the value",
      "header": "hue.user.id;p=1",
      "identity": null
    },
    {
      "name": "an empty header",
      "header": "",
      "identity": null
    }
  ]
}

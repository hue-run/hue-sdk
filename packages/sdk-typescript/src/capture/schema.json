{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hue.run/schemas/capture/v1",
  "title": "Hue portable capture v1",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0
        },
        "mimeType": {
          "type": "string"
        },
        "encoding": {
          "enum": ["bytes", "json", "utf8"]
        }
      },
      "required": ["artifactId", "sha256", "byteSize", "mimeType", "encoding"]
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "json"
            },
            "value": {
              "$ref": "#/$defs/json"
            }
          },
          "required": ["kind", "value"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "base64": {
              "type": "string"
            }
          },
          "required": ["kind", "base64"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "blob"
            },
            "ref": {
              "$ref": "#/$defs/blob"
            }
          },
          "required": ["kind", "ref"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stream"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/payload"
              }
            }
          },
          "required": ["kind", "items"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "statusText": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "url": {
              "type": "string"
            },
            "body": {
              "allOf": [
                {
                  "$ref": "#/$defs/payload"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": ["bytes", "blob"]
                    },
                    "ref": {
                      "properties": {
                        "encoding": {
                          "const": "bytes"
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": ["kind", "status", "headers", "body"]
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": ["tool", "mcp", "http"]
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https?://[^/?#@]+$"
            },
            "pathPrefix": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["origin", "pathPrefix"]
        },
        "accountScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["id", "kind", "contractVersion"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": ["http"]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "content": {
          "enum": ["complete", "partial", "reference_only", "unavailable"]
        },
        "relation": {
          "enum": ["query_attachment", "tool_source"]
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceVersion": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/json"
        }
      },
      "required": ["id", "content", "relation"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": ["start", "finish"]
        },
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "arguments": {
          "$ref": "#/$defs/payload"
        },
        "parentCallId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "type": "string"
        },
        "outcome": {
          "enum": ["success", "error", "cancelled", "incomplete"]
        },
        "result": {
          "$ref": "#/$defs/payload"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "code": {
              "$ref": "#/$defs/json"
            }
          },
          "required": ["type"]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "replayable": {
          "type": "boolean"
        },
        "omissionReason": {
          "type": "string"
        },
        "externalSpanId": {
          "type": "string",
          "pattern": "^(?!0{16}$)[a-f0-9]{16}$"
        }
      },
      "required": [
        "id",
        "callId",
        "producerId",
        "sequence",
        "phase",
        "bindingId",
        "operation",
        "contractVersion",
        "requestKey",
        "at",
        "replayable"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "start"
              }
            }
          },
          "then": {
            "required": ["arguments"],
            "not": {
              "anyOf": [
                {
                  "required": ["outcome"]
                },
                {
                  "required": ["result"]
                },
                {
                  "required": ["error"]
                },
                {
                  "required": ["sources"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "finish"
              }
            }
          },
          "then": {
            "required": ["outcome"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "success"
                    }
                  }
                },
                "then": {
                  "required": ["result"]
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "error"
                    }
                  }
                },
                "then": {
                  "required": ["error"]
                }
              }
            ]
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["producerId", "lastSequence", "pending", "dropped"]
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["code", "message"]
    },
    "stateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schemaVersion": {
          "const": "1"
        },
        "adapter": {
          "enum": ["gmail@1", "slack@1", "gmail-provider@1"]
        },
        "kind": {
          "enum": ["initial_snapshot", "before_image", "execution_journal"]
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "enum": ["pre_execution", "before_operation", "after_execution"]
            },
            "callId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "completeCollections": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "omissions": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "required": ["phase", "completeCollections", "omissions"]
        },
        "initialState": {
          "$ref": "#/$defs/json"
        },
        "actions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        "causalDependencies": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "coverage": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "collection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "query": {
                "$ref": "#/$defs/json"
              },
              "complete": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": ["string", "null"],
                "maxLength": 2000
              }
            },
            "required": ["collection", "complete"]
          }
        },
        "providerInterface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "gmail-provider/v1"
            },
            "providerInstances": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/json"
                }
              }
            },
            "mcpTools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "inputSchema": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "outputSchema": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  }
                },
                "required": ["name", "inputSchema"]
              }
            },
            "restOperations": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "inputSchema": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "outputSchema": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  }
                },
                "required": ["name", "inputSchema"]
              }
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "environmentVersionId": {
              "type": "string",
              "format": "uuid"
            },
            "environmentRunId": {
              "type": "string",
              "format": "uuid"
            },
            "executionId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "schemaVersion",
            "providerInstances",
            "mcpTools",
            "restOperations",
            "scopes",
            "environmentVersionId",
            "environmentRunId",
            "executionId"
          ]
        },
        "journal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "hue.environment-journal/v1"
            },
            "environmentVersionId": {
              "type": "string",
              "format": "uuid"
            },
            "environmentRunId": {
              "type": "string",
              "format": "uuid"
            },
            "executionId": {
              "type": "string",
              "format": "uuid"
            },
            "complete": {
              "type": "boolean"
            },
            "stepCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "validity": {
              "enum": ["not_assessed", "environment_incomplete"]
            },
            "coverageGap": {
              "$ref": "#/$defs/json"
            },
            "steps": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "invocationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "observation": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "effects": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": ["created", "updated", "deleted"]
                        },
                        "collection": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "entityId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "fields": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        }
                      },
                      "required": ["kind", "collection", "entityId", "fields"]
                    }
                  },
                  "mutated": {
                    "type": "boolean"
                  },
                  "clockNs": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$"
                  },
                  "stateDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "id",
                  "ordinal",
                  "invocationId",
                  "action",
                  "args",
                  "observation",
                  "effects",
                  "mutated",
                  "clockNs",
                  "stateDigest"
                ]
              }
            },
            "providerCalls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "complete": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array",
                  "maxItems": 2000,
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  }
                }
              },
              "required": ["complete", "items"]
            },
            "worldStatus": {
              "enum": ["open", "completed", "abandoned"]
            }
          },
          "required": [
            "schemaVersion",
            "environmentVersionId",
            "environmentRunId",
            "executionId",
            "complete",
            "stepCount",
            "validity",
            "coverageGap",
            "steps",
            "providerCalls",
            "worldStatus"
          ]
        }
      },
      "required": [
        "id",
        "schemaVersion",
        "adapter",
        "kind",
        "service",
        "accountId",
        "actorId",
        "boundary"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "execution_journal"
              }
            }
          },
          "then": {
            "required": ["journal"],
            "properties": {
              "adapter": {
                "const": "gmail-provider@1"
              },
              "boundary": {
                "properties": {
                  "phase": {
                    "const": "after_execution"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": ["journal"]
            }
          }
        },
        {
          "if": {
            "required": ["providerInterface"]
          },
          "then": {
            "properties": {
              "adapter": {
                "const": "gmail-provider@1"
              },
              "kind": {
                "const": "initial_snapshot"
              },
              "boundary": {
                "properties": {
                  "phase": {
                    "const": "pre_execution"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "gmail-provider@1"
              },
              "kind": {
                "const": "initial_snapshot"
              }
            }
          },
          "then": {
            "required": ["providerInterface"]
          }
        },
        {
          "if": {
            "properties": {
              "boundary": {
                "properties": {
                  "phase": {
                    "const": "after_execution"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "execution_journal"
              }
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "captureId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "externalTraceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "input": {
          "$ref": "#/$defs/payload"
        },
        "capturePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceContent": {
              "const": true
            },
            "redactionVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["sourceContent", "redactionVersion"]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/producer"
          }
        },
        "stateEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateEvidence"
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/omission"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finalizedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [

{
  "name": "hue-sdk-repo-tooling",
  "private": true,
  "type": "module",
  "description": "Lint and formatting tooling for the repository; not published.",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/sdk-typescript/{src,tests,scripts}/**/*.{ts,mjs}\" \"examples/reference-chatbot/{src,scripts}/**/*.{ts,mjs}\"",
    "format": "prettier --write \"packages/sdk-typescript/{src,tests,scripts}/**/*.{ts,mjs}\" \"examples/reference-chatbot/{src,scripts}/**/*.{ts,mjs}\"",
    "docs:typescript": "typedoc --emit none",
    "docs:typescript:html": "typedoc",
    "docs:contract": "python3 scripts/generate-docs-contract.py",
    "docs:contract:check": "python3 scripts/generate-docs-contract.py --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
